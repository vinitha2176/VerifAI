# VerifAI Backend Configuration
# Tagline: Verify opportunities. Protect your future.
APP_NAME=VerifAI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173

# Database configuration
DATABASE_URL=sqlite:///./verifai.db

# ML Model configuration
MODEL_PATH=ml/saved_model/model.joblib
METRICS_PATH=ml/saved_model/metrics.json

# File upload limit (in megabytes)
MAX_UPLOAD_SIZE_MB=10
